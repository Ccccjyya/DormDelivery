<view class="page data-v-5d3b8a8d"><view class="title data-v-5d3b8a8d">管理员管理</view><view class="tabs data-v-5d3b8a8d"><button class="{{['tab', 'data-v-5d3b8a8d', a && 'active']}}" bindtap="{{b}}">当前管理员</button><button class="{{['tab', 'data-v-5d3b8a8d', c && 'active']}}" bindtap="{{d}}">可任命用户</button></view><view class="search-row data-v-5d3b8a8d"><input class="input search data-v-5d3b8a8d" placeholder="姓名、学号或手机号" confirm-type="search" bindconfirm="{{e}}" value="{{f}}" bindinput="{{g}}"/><button class="search-btn data-v-5d3b8a8d" bindtap="{{h}}">查询</button></view><view wx:if="{{i}}" class="error-state data-v-5d3b8a8d"><view class="data-v-5d3b8a8d">{{j}}</view><button class="retry data-v-5d3b8a8d" bindtap="{{k}}">重新加载</button></view><view wx:elif="{{l}}" class="empty data-v-5d3b8a8d">列表加载中…</view><block wx:else><view wx:for="{{m}}" wx:for-item="item" wx:key="i" class="card user-card data-v-5d3b8a8d"><view class="row data-v-5d3b8a8d"><text class="name data-v-5d3b8a8d">{{item.a}}</text><text class="status data-v-5d3b8a8d">{{item.b}}</text></view><view class="data-v-5d3b8a8d">学号：{{item.c}}</view><view class="data-v-5d3b8a8d">宿舍楼：{{item.d}}</view><button wx:if="{{n}}" class="btn danger data-v-5d3b8a8d" loading="{{item.e}}" bindtap="{{item.f}}">取消管理员</button><button wx:else class="btn data-v-5d3b8a8d" loading="{{item.g}}" bindtap="{{item.h}}">任命管理员</button></view><view wx:if="{{o}}" class="empty data-v-5d3b8a8d">{{p}}</view><view wx:elif="{{q}}" class="end data-v-5d3b8a8d">没有更多了</view></block></view>